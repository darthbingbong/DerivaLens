# .env.example
# Copy this to .env and fill in your own values
# DO NOT commit .env to git (it contains sensitive data)

# API Keys (if using live data providers)
# ALPHAVANTAGE_API_KEY=your_key_here
# POLYGON_API_KEY=your_key_here

# Database
# DATABASE_URL=postgresql://user:password@localhost/derivalens

# Data paths
# RAW_DATA_PATH=/path/to/raw/data
# PROCESSED_DATA_PATH=/path/to/processed/data

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Backtesting
DEFAULT_RISK_FREE_RATE=0.05
DEFAULT_SLIPPAGE_BPS=2
DEFAULT_COMMISSION_BPS=1

# Regime classification
REGIME_MODEL_PATH=./models/regime_classifier.pkl

# Random seed for reproducibility
RANDOM_SEED=42
